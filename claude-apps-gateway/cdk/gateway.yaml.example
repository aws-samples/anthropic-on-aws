# gateway.yaml.template — Claude apps gateway config for the AWS / Bedrock worked example.
#
# This file is COMMITTED. `stamp-config.sh` substitutes the build-time
# double-at placeholders below with real literal values (from deploy inputs) to
# produce `gateway.yaml`, which the Dockerfile COPYs into the image. Baking (vs. mounting)
# for why config is baked into the image on ECS rather than mounted as a secret file.
#
# Two kinds of placeholder appear here, and they are resolved at DIFFERENT times:
#
#   double-at  (PUBLIC_URL, AWS_REGION, ...) — BUILD time. Replaced by
#               stamp-config.sh before `docker build`. These are non-secret values
#               known at deploy and rarely changed (public_url, region, issuer,
#               client_id, email domains). Baking them means the image is
#               per-environment by design (baked config = one image per environment).
#
#   dollar-brace  ${NAME} — BOOT time. Expanded by the gateway itself when it reads
#               the file. Used for exactly two categories: secrets (never committed)
#               and values that don't exist until the deploy creates them (the RDS
#               endpoint + generated DB credentials). stamp-config.sh leaves these
#               untouched.
#
# Run the gateway with:  claude gateway --config /etc/claude/gateway.yaml
# Operational log verbosity is the CLAUDE_GATEWAY_LOG_LEVEL env var
# (info | warn | error; default info). It never affects audit events.

listen:
  host: 0.0.0.0
  port: 8080
  # The externally visible HTTPS origin. The gateway builds its OIDC redirect_uri
  # and discovery doc ONLY from this — never from X-Forwarded-* (those are
  # client-spoofable). Must resolve to PRIVATE IPs only on developer machines, or
  # `/login` rejects it. Here it is the internal ALB's hostname.
  public_url: https://claude-gateway.example.com
  # The ALB terminates TLS (bring-your-own ACM cert), so the gateway speaks plain
  # HTTP behind it — no `tls:` block. Trust X-Forwarded-For only from the ALB so
  # real client IPs surface for per-IP rate limits and audit. Set to the ALB
  # subnet CIDRs (the private-subnet ranges the ALB ENIs live in).
  # trusted_proxies:
  #   - 10.0.0.0/8

oidc:
  # All three below are non-secret, known at deploy, and rarely change → baked.
  issuer: https://example.okta.com
  client_id: 0oa1example2
  client_secret: ${OIDC_CLIENT_SECRET}   # the one secret in this block (env-injected)
  allowed_email_domains: [example.com]
  # Per-IdP notes — uncomment what your provider needs:
  #   Okta (org server https://example.okta.com): id_token omits email/groups →
  #     userinfo_fallback: true
  #   Okta (custom server .../oauth2/default): emits claims directly, no fallback.
  #   Microsoft Entra: issuer https://login.microsoftonline.com/<tenant>/v2.0 ;
  #     groups arrive as Object IDs (GUIDs) — match on those, or use App Roles
  #     with `groups_claim: roles`.
  #   Keycloak / Dex behind corporate PKI: set `ca_cert_pem:`; lightweight access
  #     tokens need `userinfo_fallback: true`.
  # userinfo_fallback: true

session:
  jwt_secret: ${GATEWAY_JWT_SECRET}   # >= 32 bytes, e.g. `openssl rand -base64 32`
  # Bearer token lifetime. Default 1h is the secure choice: it assumes the IdP
  # issues refresh tokens (offline_access, in the default scopes), so the CLI
  # renews silently AND a disabled user loses access within <= 1h on the next
  # failed refresh.
  ttl_hours: 1
  # Refresh-token recipes by IdP:
  #   Okta / Entra: default `offline_access` scope suffices.
  #   Google: ignores offline_access — set, in the oidc block:
  #     scopes: [openid, profile, email]
  #     extra_auth_params: { access_type: offline, prompt: consent }
  # Opt-out: ONLY if your IdP can't issue refresh tokens, raise ttl_hours to 8-12
  # (no silent renewal otherwise) — deprovisioning then lags by that TTL.

store:
  # Credentials are split OUT of the URL (store.username/password take precedence
  # over any creds in the URL) so they stay in the RDS-generated secret. The host
  # is a deploy-created fact, so it's an env var, not baked; the db-name is baked.
  postgres_url: postgres://${DB_HOST}:5432/claude_gateway?sslmode=require
  username: ${DB_USER}
  password: ${DB_PASSWORD}
  # max_connections: 5   # keep replicas x this below RDS max_connections

upstreams:
  - provider: bedrock
    region: us-east-1
    auth: {}                 # AWS default credential chain → the ECS task role
    # FIPS / VPC-endpoint override:
    # base_url: https://bedrock-runtime-fips.us-east-1.amazonaws.com
  # Multi-upstream failover (provisioned-throughput → on-demand → second region).
  # Give each a distinct `name:`. On 2.1.198+ the gateway fails over on 5xx, 429,
  # 401, 403, 404, and timeout — so an upstream that hasn't enabled a model (404)
  # falls through to one that has; other 4xx (a bad request) does not. (Pre-2.1.198
  # returned the first 404 to the client instead of trying later upstreams.)
  # - name: bedrock-pt
  #   provider: bedrock
  #   region: us-east-1
  #   auth: {}
  # - name: bedrock-od
  #   provider: bedrock
  #   region: us-west-2
  #   auth: {}
  # (with a matching `models:` block mapping the PT ARN to bedrock-pt)
  #
  # Claude Platform on AWS (anthropicAws) — an alternative AWS-native upstream,
  # distinct from Bedrock: it serves the first-party Anthropic API on AWS at
  # aws-external-anthropic.<region>.api.aws, uses first-party model IDs, honors
  # anthropic-beta headers, and serves count_tokens — none of Bedrock's translation
  # applies. Requires CLAUDE_VERSION >= 2.1.198 (earlier gateways reject the provider
  # at boot). It runs in a SEPARATE AWS account and signs SigV4 for its own service
  # name (aws-external-anthropic), so the Bedrock-scoped task role does NOT authorize
  # it — use an API key, or grant the task role access to that service:
  # - provider: anthropicAws
  #   region: us-east-1
  #   workspace_id: wrkspc_...        # required; sent as a header on every request
  #   auth:
  #     api_key: ${ANTHROPIC_AWS_API_KEY}   # sent as x-api-key
  #   # OR SigV4 via the AWS default credential chain: auth: {}
  # (the built-in catalog routes here with no `models:` block, since it resolves
  #  first-party model IDs; if you curate `models:`, key the entry `anthropicAws:`)

telemetry:
  # Forwards to an ADOT collector sidecar running in the same Fargate task. The
  # collector receives OTLP on localhost:4318 and relays to CloudWatch's native
  # OTLP metrics endpoint using SigV4 via the task role — no bearer token or API
  # key to manage or rotate.
  # Telemetry turns on only when forward_to AND listen.public_url are both set;
  # the gateway then pushes OTEL_* env to clients (one-time client approval dialog).
  forward_to:
    # No /v1/metrics suffix: the gateway appends the OTLP-standard signal path
    # itself (like any OTLP HTTP exporter), so a base URL that already ends in
    # /v1/metrics gets it doubled and 404s — see gotchas.md.
    - url: http://localhost:4318
      # Default is metrics-only. Metrics are aggregate counters (tokens, requests,
      # latency, model, user identity). logs/traces carry sensitive data and should
      # only be enabled on destinations with appropriate access controls.
      metrics: true

# Explicit model catalog (see `models:` at the bottom) instead of the built-in
# one, so every model maps to a GLOBAL inference profile and no region-specific
# us.* default can leak in. `availableModels` below is the picker allowlist —
# align it with the models you've enabled access for; enforced server-side at
# /v1/messages, so a patched client can't bypass it.
auto_include_builtin_models: false
managed:
  policies:
    # Example group-scoped policy (uncomment + adapt). Specific matches first;
    # they inherit any key they don't set from the match:{} base below.
    # - match: { groups: [eng-contractors] }
    #   cli:
    #     availableModels: [claude-haiku-4-5]
    #     enforceAvailableModels: true
    #     permissions: { allow: [Read, Grep] }
    #   # Claude Desktop feature gates (see the desktop: note on the base policy below).
    #   desktop:
    #     isLocalDevMcpEnabled: false
    #     disableAutoUpdates: true
    #     # `enabled: true` is REQUIRED — Desktop's banner.enabled has no default, so a
    #     # banner with only `text:` renders nothing.
    #     banner: { enabled: true, text: "Contractor build: internal use only" }
    # Per-team cost attribution: OTEL_RESOURCE_ATTRIBUTES is stamped on every
    # OTLP export, so CloudWatch's PromQL layer can group spend/usage by team
    # (sum by ("@resource.team.id") (...)) same as user.id/user.email already are.
    # - match: { groups: [team-platform] }
    #   cli:
    #     env:
    #       OTEL_RESOURCE_ATTRIBUTES: "team.id=platform,department=engineering,cost_center=cc-1001"
    # Catch-all base: matches every authenticated user.
    - match: {}
      cli:
        availableModels:
          - claude-opus-4-8
          - claude-sonnet-5
          - claude-haiku-4-5
          # - claude-fable-5   # opt-in — see the models: block note below
        enforceAvailableModels: true
        # CLAUDE DESKTOP, part 1 of 2 (uncomment if you deploy Desktop). Desktop hands
        # this policy to the embedded Claude Code sessions it launches as PARENT
        # settings, and Claude Code IGNORES parent settings on a machine with an
        # admin-deployed managed source unless the WINNING source opts in with this key
        # — so mirror it in the MDM managed-settings.json (and in any HKLM policy /
        # macOS plist, which outrank the file). Machines that never sign in to the
        # gateway get policy from that file alone. Left off by default because it also
        # lets ANY launching host (Agent SDK app, IDE extension) supply parent settings;
        # the filter is restrictive-only except for allow rules and sandbox allowlists,
        # so pair it with the allowManaged*Only locks. See the README.
        # parentSettingsBehavior: merge
      #
      # CLAUDE DESKTOP, part 2 of 2 — the /user/bootstrap opt-in. Presence of a
      # `desktop` key is what makes the gateway serve Desktop's configuration to this
      # policy's users; without it /user/bootstrap 404s for everyone (the safe default,
      # so this stays commented) and Desktop reports it can't fetch its config. Each
      # request is audited as desktop_bootstrap.serve / .denied. On the match:{} base
      # layer it opts in every policy that inherits. Requires gateway >= 2.1.203.
      #
      # `desktop: {}` on its own is a complete opt-in. The keys below are optional
      # feature gates with no CLI equivalent; each one omitted keeps Desktop's own
      # default, and an UNKNOWN key here fails gateway boot. The rest of the response
      # comes from the cli: block above — availableModels, bare tool-name
      # permissions.deny entries, sandbox.network.allowedDomains, and an OTLP endpoint
      # when telemetry.forward_to is set. hooks and scoped rules like Bash(npm *) have
      # no Desktop equivalent and are dropped.
      #
      # Desktop clients need the other half: `bootstrapUrl` set to
      # <public_url>/user/bootstrap in Claude Desktop's own managed configuration — a
      # DIFFERENT key from the CLI's forceLoginGatewayUrl.
      # desktop:
      #   modelDiscoveryEnabled: false          # rely only on availableModels above
      #   coworkTabEnabled: true
      #   isClaudeCodeForDesktopEnabled: true
      #   isDesktopExtensionEnabled: true
      #   isDesktopExtensionSignatureRequired: true
      #   isLocalDevMcpEnabled: false
      #   disableAutoUpdates: false
      #   autoUpdaterEnforcementHours: 72
      #   banner: { enabled: true, text: "Internal gateway build", linkUrl: https://wiki.example.com/claude }

# Optional blocks, left commented:
#
# admin:        # enables /v1/organizations/spend_limits + per-developer spend caps
#   write_keys:
#     - { id: terraform, key: "${GATEWAY_ADMIN_WRITE_KEY}" }
#   read_keys:
#     - { id: reporting, key: "${GATEWAY_ADMIN_READ_KEY}" }
#   # Both optional: admin_groups lets members of an IdP group call the admin API
#   # with their session bearer token instead of an x-api-key; blocked_message is
#   # appended to the 429 a capped developer sees. The admin block is validated
#   # STRICTLY — an unknown key here fails the boot.
#   admin_groups: [platform-finops]
#   blocked_message: "Contact platform-team@company.com to request a higher limit."
#   # NOTE 1: enabling admin makes Postgres hold durable spend + audit + PII. Harden
#   # RDS (backups, deletion protection, multi-AZ) — see the README "Productionising".
#   # NOTE 2: uncommenting this is NOT sufficient on its own. The ${...} keys are
#   # expanded by the gateway at boot from the task definition's env, so the two
#   # secrets must be minted and injected in the SAME deploy or the container
#   # crash-loops with "undefined env var in config". Full steps: README §5.
#
# Model catalog. Each id maps to a GLOBAL cross-region inference profile
# (global.anthropic.*), which resolves from ANY Bedrock region — so this config is
# region-agnostic. For data residency, swap global. for a geo profile (us./eu./au.,
# plus jp. for Opus 4.8 and Haiku 4.5 — Sonnet 5 has no jp. profile) and confirm the
# exact id per model with `aws bedrock list-inference-profiles`
# (see the README "Regions & data residency"). Claude Haiku 4.5 has no short alias —
# it uses the dated profile id. For provisioned throughput, point `bedrock:` at the PT ARN.
#
# Claude Fable 5 is opt-in: on Bedrock it requires a non-default data retention mode
# that isn't enabled in every region, so it 400s ("data retention mode 'default' is
# not available for this model") where the default three deploy cleanly. To add it,
# enable the retention prereq for your region, uncomment it in availableModels above,
# and uncomment the entry below.
models:
  - id: claude-opus-4-8
    label: Claude Opus 4.8
    upstream_model:
      bedrock: global.anthropic.claude-opus-4-8
  - id: claude-sonnet-5
    label: Claude Sonnet 5
    upstream_model:
      bedrock: global.anthropic.claude-sonnet-5
  - id: claude-haiku-4-5
    label: Claude Haiku 4.5
    upstream_model:
      bedrock: global.anthropic.claude-haiku-4-5-20251001-v1:0
  # - id: claude-fable-5
  #   label: Claude Fable 5
  #   upstream_model:
  #     bedrock: global.anthropic.claude-fable-5
