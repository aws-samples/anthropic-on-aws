        <mxCell id="e11" value="public HTTPS egress&#xa;(tunnels, packages, opt. Claude.ai)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#7f7f7f;dashed=1;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="microvm" target="natgw" edge="1">
          <mxGeometry relative="1" as="geometry">
