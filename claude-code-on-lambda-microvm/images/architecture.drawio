        </mxCell>
        <mxCell id="e7" value="6a. outbound tunnel host — TLS via connector + NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#067F68;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="microvm" target="tunnels" edge="1">
